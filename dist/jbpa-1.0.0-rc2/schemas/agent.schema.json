        },
        "require_cloud_confirmation": {
          "const": true
        },
        "profile": {
          "enum": [
            "INITIAL_REGISTRATION",
            "STEADY_STATE_EXISTING_AGENT",
            "EXISTING_AGENT_START",
            "EXISTING_AGENT_RESTART",
            "POST_CONFIGURATION_RESTART",
            "POST_ROLLBACK_RESTART"
          ]
        },
        "expected_identity": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "agent_id",
            "group_id",
            "agent_name",
            "group_name",
            "package_version"
          ],
          "additionalProperties": false,
          "properties": {
            "agent_id": {
              "type": "integer",
              "minimum": 1
            },
            "group_id": {
              "type": "integer",
              "minimum": 1
            },
            "agent_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "group_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "package_version": {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+){3}$"
            }
          }
        }
      },
      "required": [
        "registration_timeout_seconds",
        "poll_interval_seconds",
        "evidence_profile",
        "require_cloud_confirmation"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "result_path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^/[^\\x00-\\x1f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "log_path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^/[^\\x00-\\x1f]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "result_path",
        "log_path"
      ],
      "additionalProperties": false
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR"
          ]
        }
      },
      "required": [
        "level"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "dry_run": {
          "type": "boolean"
        }
      },
      "required": [
        "dry_run"
      ],
      "additionalProperties": false
    },
    "artifact_policy": {
      "type": "object",
      "required": [
        "provider",
        "require_production_approval"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "vendor-catalogue"
        },
        "require_production_approval": {
          "type": "boolean"
        }
      }
    },
    "uninstall_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drain_pause_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "operation_poll_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "stop_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "stop_poll_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "qa_policy": {
      "type": "object",
      "required": [
        "cpu_exception",
        "production_sizing_validated"
      ],
      "additionalProperties": false,
      "properties": {
        "cpu_exception": {
          "enum": [
            "DISABLED",
            "EXPLICIT_CONTROLLED_TEST_FLAG_REQUIRED"
          ]
        },
        "production_sizing_validated": {
          "const": false
        }
      }
    }
  },
  "required": [
    "schema_version",
    "agent",
    "harmony",
    "secrets",
    "network",
    "proxy",
    "ssh",
    "ssl",
    "java_trust",
    "health",
    "output",
    "logging",
    "execution"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
