{
  "$defs": {
    "keyVaultReference": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "azure-key-vault"
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{1,127}$"
        }
      },
      "required": [
        "provider",
        "reference"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "agent": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(?:[0-9]+(?:\\.[0-9]+){1,3}|recommended|latest-tested|latest-available-pinned|latest)$"
        },
        "package_kind": {
          "enum": [
            "deb",
            "rpm",
            "tar"
          ]
        },
        "expected_os": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "architecture": {
              "enum": [
                "x86_64",
                "aarch64"
              ]
            }
          },
          "required": [
            "id",
            "version",
            "architecture"
          ],
          "additionalProperties": false
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "package_kind",
        "expected_os",
        "name"
      ],
      "additionalProperties": false
    },
    "harmony": {
      "type": "object",
      "properties": {
        "cloud_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/@?#\\s]+(?:/[^?#\\s]*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "organization": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_group_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_group_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "registration": {
          "type": "object",
          "properties": {
            "strategy": {
              "anyOf": [
                {
                  "enum": [
                    "register-json-token",
                    "credentials-file"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "token_secret_ref": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "enum": [
                        "azure-key-vault"
                      ]
                    },
                    "reference": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                    },
                    "version": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "provider",
                    "reference"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "username_secret_ref": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "enum": [
                        "azure-key-vault"
                      ]
                    },
                    "reference": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                    },
                    "version": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "provider",
                    "reference"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "password_secret_ref": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "enum": [
                        "azure-key-vault"
                      ]
                    },
                    "reference": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                    },
                    "version": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "provider",
                    "reference"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "deregister_on_drainstop": {
              "const": false
            }
          },
          "required": [
            "strategy",
            "token_secret_ref",
            "username_secret_ref",
            "password_secret_ref",
            "deregister_on_drainstop"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "strategy": {
                    "const": "register-json-token"
                  }
                }
              },
              "then": {
                "properties": {
                  "token_secret_ref": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "enum": [
                          "azure-key-vault"
                        ]
                      },
                      "reference": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                      },
                      "version": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "provider",
                      "reference"
                    ],
                    "additionalProperties": false
                  },
                  "username_secret_ref": {
                    "type": "null"
                  },
                  "password_secret_ref": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "strategy": {
                    "const": "credentials-file"
                  }
                }
              },
              "then": {
                "properties": {
                  "token_secret_ref": {
                    "type": "null"
                  },
                  "username_secret_ref": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "enum": [
                          "azure-key-vault"
                        ]
                      },
                      "reference": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                      },
                      "version": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "provider",
                      "reference"
                    ],
                    "additionalProperties": false
                  },
                  "password_secret_ref": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "enum": [
                          "azure-key-vault"
                        ]
                      },
                      "reference": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                      },
                      "version": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "provider",
                      "reference"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "cloud_url",
        "organization",
        "environment",
        "agent_group_id",
        "agent_group_name",
        "registration"
      ],
      "additionalProperties": false
