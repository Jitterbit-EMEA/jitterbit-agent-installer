{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "aliases": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "recommended",
          "latest-tested",
          "latest-available-pinned"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d+(?:\\.\\d+){1,3}$"
      }
    },
    "versions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^\\d+(?:\\.\\d+){1,3}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "approval": {
            "enum": [
              "pending",
              "approved_for_test",
              "approved",
              "denied"
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "os_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "os_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "architecture": {
                  "enum": [
                    "x86_64",
                    "aarch64"
                  ]
                },
                "package_kind": {
                  "enum": [
                    "deb",
                    "rpm",
                    "tar"
                  ]
                },
                "package_version": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://[^/@?#\\s]+(?:/[^?#\\s]*)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-fA-F0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "adapter_profile": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  }
                },
                "runtime_validation": {
                  "enum": [
                    "not_run",
                    "passed",
                    "failed"
                  ]
                }
              },
              "required": [
                "os_id",
                "os_version",
                "architecture",
                "package_kind",
                "package_version",
                "url",
                "sha256",
                "adapter_profile",
                "evidence_refs",
                "runtime_validation"
              ],
              "additionalProperties": false
            }
          },
          "package_version": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+){3}$"
          },
          "filename": {
            "type": "string",
            "pattern": "^jitterbit-agent_[0-9.]+_amd64\\.deb$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://download\\.jitterbit\\.com/[^?#\\s]+$"
          },
          "architecture": {
            "const": "amd64"
          },
          "package_type": {
            "const": "deb"
          },
          "integrity": {
            "type": "object",
            "required": [
              "sha256",
              "classification"
            ],
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "classification": {
                "enum": [
                  "LOCALLY_CALCULATED",
                  "INDEPENDENTLY_VERIFIED",
                  "NOT_VERIFIED"
                ]
              }
            }
          },
          "artifact_status": {
            "enum": [
              "KNOWN",
              "AVAILABLE_UNQUALIFIED",
              "METADATA_VERIFIED",
              "QA_APPROVED",
              "TESTED_MOCK",
              "TESTED_LIVE",
              "PRODUCTION_APPROVED",
              "DEPRECATED",
              "BLOCKED"
            ]
          },
          "qualification": {
            "type": "object",
            "required": [
              "overall",
              "platforms",
              "scope"
            ],
            "additionalProperties": false,
            "properties": {
              "overall": {
                "enum": [
                  "KNOWN",
                  "AVAILABLE_UNQUALIFIED",
                  "METADATA_VERIFIED",
                  "QA_APPROVED",
                  "TESTED_MOCK",
                  "TESTED_LIVE",
                  "PRODUCTION_APPROVED",
                  "DEPRECATED",
                  "BLOCKED"
                ]
              },
              "platforms": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "KNOWN",
                    "AVAILABLE_UNQUALIFIED",
                    "METADATA_VERIFIED",
                    "QA_APPROVED",
                    "TESTED_MOCK",
                    "TESTED_LIVE",
                    "PRODUCTION_APPROVED",
                    "DEPRECATED",
                    "BLOCKED",
                    "NOT_TESTED"
                  ]
                }
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "approval",
          "artifacts",
          "package_version",
          "filename",
          "url",
          "architecture",
          "package_type",
          "integrity",
          "artifact_status",
          "qualification"
        ],
        "additionalProperties": false
      }
    },
    "dynamic_sources": {
      "type": "object",
      "required": [
        "latest"
      ],
      "properties": {
        "latest": {
          "type": "object",
          "required": [
            "url",
            "mutability",
            "architecture",
            "package_type"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "const": "https://login.jitterbit.com/jitterbit-cloud-mgmt-console/download/latest/agent/linuxdebian?architecture=x64"
            },
            "mutability": {
              "const": "DYNAMIC_MUTABLE"
            },
            "architecture": {
              "const": "amd64"
            },
            "package_type": {
              "const": "deb"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "expected_pinned_count": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "aliases",
    "versions",
    "dynamic_sources",
    "expected_pinned_count"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
