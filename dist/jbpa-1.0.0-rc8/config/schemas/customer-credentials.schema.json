{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "harmony", "agent", "registration"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "harmony": {
      "type": "object",
      "required": ["registrationToken", "cloudUrl", "agentGroupId"],
      "additionalProperties": false,
      "properties": {
        "registrationToken": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "cloudUrl": {"type": "string", "format": "uri", "pattern": "^https://[^/@?#\\s]+(?:/[^?#\\s]*)?$"},
        "agentGroupId": {"type": "integer", "minimum": 1}
      }
    },
    "agent": {
      "type": "object",
      "required": ["namePrefix"],
      "additionalProperties": false,
      "properties": {
        "namePrefix": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
      }
    },
    "registration": {
      "type": "object",
      "required": ["deregisterOnDrainstop", "retryCount", "retryIntervalSeconds"],
      "additionalProperties": false,
      "properties": {
        "deregisterOnDrainstop": {"const": false},
        "retryCount": {"const": 10},
        "retryIntervalSeconds": {"const": 5}
      }
    }
  }
}
