{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "user", "identityFile", "knownHostsFile"],
        "properties": {
          "host": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$"},
          "user": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$"},
          "identityFile": {"type": "string", "pattern": "^/"},
          "knownHostsFile": {"type": "string", "pattern": "^/"},
          "credentialsFile": {"type": "string", "pattern": "^/"}
        }
      }
    }
  }
}
